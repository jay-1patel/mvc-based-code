# Copy to .env in this same folder (routing/.env) and fill in the real values.
#   cp routing/.env.example routing/.env
# Never commit routing/.env — .gitignore excludes it; only this .example is safe to share.
# Keys below are placeholders only. Values shown are the defaults already in
# routing/config.py, kb/services/brain.py, backend/faq/service.py or README.md.

# ── LLM provider ──────────────────────────────────────────────────────────
# routing/config.py defaults API_PROVIDER to "groq", while
# kb/services/brain.py defaults it to "ollama". Set it explicitly so the
# two do not disagree. "ollama" matches the README (FastAPI + Ollama + RAG)
# and backend/faq/service.py, which is Ollama-only.
API_PROVIDER=ollama

# Ollama — set BOTH URLs. brain.py only registers Ollama when OLLAMA_API_URL
# is set; other code derives the chat URL from OLLAMA_BASE_URL when API_URL
# is missing, so setting both keeps every path working.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen3:8b

# Groq (only needed if API_PROVIDER=groq)
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
# GROQ_API_KEY=
# GROQ_MODEL=

# Mistral (optional fallback; brain.py also accepts MISTRAL_API_BACKUP as key)
# MISTRAL_API_URL=
# MISTRAL_API_KEY=
# MISTRAL_MODEL=

# ── WhatsApp / send2.digital ──────────────────────────────────────────────
WHATSAPP_VERIFY_TOKEN=
SEND2_USERNAME=
SEND2_PASSWORD=
SEND2_NUMBER=
# SEND2_SESSION_MSG_URL is used by backend/routes/status.py to check Send2.
# SEND2_SESSION_SEND_URL defaults to https://api.send2.digital/devdesk/session-msg-send
# SEND2_INCOMING_ENTRY_URL defaults to https://api.send2.digital/devdesk/AI_chatbot_API_incomingentry
# SEND2_SESSION_MSG_URL=
# SEND2_INCOMING_URL=
# SEND2_LIST_MENU_URL=
# SEND2_QUICK_BUTTON_URL=
# SEND2_MEDIA_URL=
# SEND2_TEMPLATE_URL=

# ── Server / database ─────────────────────────────────────────────────────
# Unified service is backend/main.py on port 9000 (see README.md / OPS_RUNBOOK.md).
ROUTER_PORT=9000
# Defaults to <repo-root>/faq.db — the same file backend/database.py opens.
# Only set this if the DB lives elsewhere; keep it identical for app and routing.
# ROUTING_DB_PATH=faq.db
# DEFAULT_TENANT_ID=

# ── Admin / auth ──────────────────────────────────────────────────────────
# Generate real secrets before any shared use; these are placeholders only.
ADMIN_SECRET_KEY=CHANGE_ME_generate_a_long_random_secret
ADMIN_JWT_SECRET=CHANGE_ME_generate_a_long_random_secret
# ADMIN_RECOVERY_KEY=

# ── Brand (optional — tenant profile in clients/<id>/config.json wins) ───
# BRAND_NAME=
# BRAND_TAGLINE=
# SUPPORT_EMAIL=
# SUPPORT_PHONE=
# BRAND_WEBSITE=
# BOT_NAME=

# ── Email / SMTP for OTP delivery (defaults: smtp.gmail.com:587) ─────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=

# ── Public URL / tunnel ───────────────────────────────────────────────────
# PUBLIC_BASE_URL=
# HKDEK_WEBHOOK_URL=

# ── Optional ──────────────────────────────────────────────────────────────
# EMBEDDING_MODEL_PATH=sentence-transformers/all-MiniLM-L6-v2
# IMGHIPPO_API_KEY=
# SEND2_POLLER_ENABLED=1
# HANDOFF_TIMEOUT_NOTIFY=0

# ── Runtime upload storage (outside the repo) ─────────────────────────────
# Runtime files users/admins upload must NOT live inside the repo tree.
# backend/extract.py reads UPLOAD_DIR (default: backend/uploaded_files/).
# Point it at external storage outside the checkout; the DB keeps the
# records (admin_files) and the searchable chunks/embeddings, and only the
# raw originals live here. Example:
# UPLOAD_DIR=/srv/mvc-storage/uploaded_files
# EXTRACTED_DIR=/srv/mvc-storage/uploaded_files/extracted
